{
  "info": {
    "_postman_id": "b93c8340-9a3e-4b45-9271-9c869c9d4b00",
    "name": "Library Management System - REST API Suite (Phase 3)",
    "description": "Comprehensive QA Test Suite for Circulation, Membership, and Catalogue Microservices with Optimistic Locking verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/Servlet_SD",
      "type": "string"
    },
    {
      "key": "testBarcode",
      "value": "BC-EJ-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Catalogue - Search Books",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/catalog/search?q=Java&onlyAvailable=true&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "catalog", "search"],
          "query": [
            { "key": "q", "value": "Java" },
            { "key": "onlyAvailable", "value": "true" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains books list', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('books');",
              "    pm.expect(jsonData.books).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Circulation - Create Reservation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberId\": 1,\n  \"bookId\": 2,\n  \"holdDays\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/reservations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "reservations"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Reservation status is PENDING', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('PENDING');",
              "    pm.expect(jsonData.queuePosition).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Circulation - Checkout Copy (Happy Path)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberId\": 1,\n  \"barcode\": \"{{testBarcode}}\",\n  \"version\": 1,\n  \"durationDays\": 14\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/loans/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "loans", "checkout"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Checkout returns 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Loan status is ACTIVE', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ACTIVE');",
              "    pm.collectionVariables.set('createdLoanId', jsonData.loanId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Circulation - Checkout Competing Member (409 Conflict)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberId\": 2,\n  \"barcode\": \"{{testBarcode}}\",\n  \"version\": 1,\n  \"durationDays\": 14\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/loans/checkout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "loans", "checkout"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Error code is OPTIMISTIC_LOCK_CONFLICT', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.errorCode).to.eql('OPTIMISTIC_LOCK_CONFLICT');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Circulation - Return Loaned Copy",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"barcode\": \"{{testBarcode}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/loans/return",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "loans", "return"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Loan status is RETURNED', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('RETURNED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
